<% var pageTitle = player.name %>
<%- include('partials/header') %>
<div class="player-detail">
  <div class="photo">
    <% if (player.photo) { %>
      <div class="ph-photo" style="position:absolute;inset:0;background:url(<%= player.photo %>) center/cover"></div>
    <% } else { %>
      <div class="ph-empty" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#2e3d34">
        <svg viewBox="0 0 48 48" width="46%"><g fill="currentColor"><ellipse cx="24" cy="31" rx="11" ry="9"/><ellipse cx="12" cy="19" rx="4" ry="5.5"/><ellipse cx="20" cy="14" rx="4" ry="6"/><ellipse cx="28" cy="14" rx="4" ry="6"/><ellipse cx="36" cy="19" rx="4" ry="5.5"/></g></svg>
      </div>
    <% } %>
  </div>
  <div>
    <a class="more" href="/jugadores" style="text-transform:uppercase;font-family:'Barlow Condensed';font-weight:700">← Jugadores</a>
    <h1 style="font-size:clamp(2rem,5vw,3.2rem);margin-top:12px">
      <% if (player.number) { %><span style="color:var(--primary-d)">#<%= player.number %></span> <% } %><%= player.name %>
    </h1>
    <dl>
      <% if (player.position) { %><dt>Posición</dt><dd><%= player.position %></dd><% } %>
      <% if (player.height) { %><dt>Estatura</dt><dd><%= player.height %></dd><% } %>
      <% if (player.birthdate) { %><dt>Nacimiento</dt><dd><%= fmtDate(player.birthdate) %></dd><% } %>
    </dl>
    <% if (player.bio) { %><div class="content article" style="padding:0;max-width:none"><%- bioHtml %></div><% } %>
  </div>
</div>
<%- include('partials/footer') %>
