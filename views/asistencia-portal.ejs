<% var pageTitle = 'Asistencia' %>
<%- include('partials/asist-head') %>
<%
  function fechaLarga(iso){
    if(!iso) return '';
    var d = new Date(iso + 'T12:00:00');
    var dias = ['domingo','lunes','martes','miércoles','jueves','viernes','sábado'];
    var mes  = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
    return dias[d.getDay()] + ' ' + d.getDate() + ' ' + mes[d.getMonth()] + ' ' + d.getFullYear();
  }
%>

<div class="form-card" style="max-width:960px">
  <h1>Asistencia a entrenamientos</h1>
  <p class="hint">Entrenamientos: <b>viernes 21:00–22:00</b> en <b><%= def.place %></b>. Se controla la asistencia de los jugadores del plantel.</p>

  <h2 style="margin-top:18px">Registrar un entrenamiento</h2>
  <form method="post" action="/asistencia" style="display:flex;gap:10px;flex-wrap:wrap;align-items:end;margin-bottom:6px">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label style="display:flex;flex-direction:column;gap:4px">Fecha (viernes)
      <input type="date" name="date" value="<%= hoy %>" required style="padding:8px;border:1px solid var(--line);border-radius:8px">
    </label>
    <label style="display:flex;flex-direction:column;gap:4px;flex:1;min-width:180px">Lugar
      <input type="text" name="place" value="<%= def.place %>" style="padding:8px;border:1px solid var(--line);border-radius:8px">
    </label>
    <label style="display:flex;flex-direction:column;gap:4px">Desde
      <input type="time" name="start" value="<%= def.start %>" style="padding:8px;border:1px solid var(--line);border-radius:8px">
    </label>
    <label style="display:flex;flex-direction:column;gap:4px">Hasta
      <input type="time" name="end" value="<%= def.end %>" style="padding:8px;border:1px solid var(--line);border-radius:8px">
    </label>
    <button class="btn primary">Crear y tomar asistencia</button>
  </form>
  <p class="hint">Si el entrenamiento de esa fecha ya existe, se abre para editar (no se duplica).</p>

  <h2 style="margin-top:22px">Entrenamientos</h2>
  <% if (!sessions.length) { %>
    <p class="muted">Aún no hay entrenamientos registrados. Crea el primero arriba.</p>
  <% } else { %>
  <div style="overflow-x:auto">
    <table class="tbl">
      <thead><tr><th>Fecha</th><th>Lugar</th><th>Presentes</th><th>Justif.</th><th>Ausentes</th><th></th></tr></thead>
      <tbody>
        <% sessions.forEach(function(s){ %>
        <tr>
          <td><b><%= fechaLarga(s.date) %></b><br><span class="muted sm"><%= (s.start_time||'') %><%= s.end_time?('–'+s.end_time):'' %></span></td>
          <td class="muted"><%= s.place || '' %></td>
          <td><b><%= s.present %></b></td>
          <td class="muted"><%= s.justified %></td>
          <td class="muted"><%= s.absent %></td>
          <td>
            <div class="actions">
              <a class="btn primary sm" href="/asistencia/<%= s.id %>">Asistencia</a>
              <a class="btn ghost sm" href="/asistencia/<%= s.id %>/bitacora"><%= s.haslog ? 'Bitácora ✓' : 'Bitácora' %></a>
              <form method="post" action="/asistencia/<%= s.id %>/eliminar" data-confirm="¿Eliminar este entrenamiento, su asistencia y su bitácora?">
                <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">×</button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <h2 style="margin-top:24px">Resumen por jugador
    <a class="btn ghost sm" href="/asistencia/resumen.csv" style="float:right">Descargar CSV</a>
  </h2>
  <p class="hint">Sobre un total de <b><%= summary.totalSessions %></b> entrenamiento(s).</p>
  <% if (!summary.rows.length) { %>
    <p class="muted">No hay jugadores activos en el plantel.</p>
  <% } else { %>
  <div style="overflow-x:auto">
    <table class="tbl">
      <thead><tr><th>#</th><th>Jugador</th><th>Presente</th><th>Justif.</th><th>Ausente</th><th>% Asistencia</th></tr></thead>
      <tbody>
        <% summary.rows.forEach(function(r){ %>
        <tr>
          <td class="muted"><%= r.player.number || '' %></td>
          <td><%= r.player.name %></td>
          <td><b><%= r.present %></b></td>
          <td class="muted"><%= r.justified %></td>
          <td class="muted"><%= r.absent %></td>
          <td><b style="color:<%= r.pct>=75?'#1f9b57':(r.pct>=50?'#f0982a':'#e0453f') %>"><%= r.pct %>%</b></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
<%- include('partials/asist-foot') %>
