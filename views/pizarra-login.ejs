<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex">
  <title>Pizarra · <%= s.site_title %></title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Barlow:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/admin.css">
  <style>:root{ --primary: <%= /^#[0-9a-fA-F]{3,8}$/.test(s.primary) ? s.primary : '#1f9b57' %>; } body.admin{background:var(--dark)}</style>
</head>
<body class="admin">
  <div class="login-wrap">
    <div class="login-brand"><svg viewBox="0 0 48 48"><g fill="var(--primary)"><ellipse cx="24" cy="31" rx="11" ry="9"/><ellipse cx="12" cy="19" rx="4" ry="5.5"/><ellipse cx="20" cy="14" rx="4" ry="6"/><ellipse cx="28" cy="14" rx="4" ry="6"/><ellipse cx="36" cy="19" rx="4" ry="5.5"/></g></svg></div>
    <h1 style="text-align:center">Pizarra táctica</h1>
    <p class="muted" style="text-align:center;margin-top:-8px">Acceso del cuerpo técnico</p>
    <% if (error) { %><p style="color:#e0605a;font-weight:600;text-align:center"><%= error %></p><% } %>
    <form method="post" action="/pizarra/login">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field"><label for="u">Usuario</label><input type="text" id="u" name="user" autocapitalize="none" autocorrect="off" autofocus required></div>
      <div class="field"><label for="p">Clave</label><input type="password" id="p" name="password" required></div>
      <button class="btn primary" style="width:100%;justify-content:center">Entrar a la pizarra</button>
    </form>
    <p style="text-align:center;margin-top:16px"><a href="/">← Volver al sitio</a></p>
  </div>
</body>
</html>
