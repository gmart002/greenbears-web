<% var pageTitle = 'Asistencia' %>
<%- include('partials/entrenos-head') %>
<%
  function fechaLarga(iso){
    if(!iso) return '';
    var d=new Date(iso+'T12:00:00');
    var dias=['domingo','lunes','martes','miércoles','jueves','viernes','sábado'];
    var mes=['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
    return dias[d.getDay()]+' '+d.getDate()+' de '+mes[d.getMonth()]+' '+d.getFullYear();
  }
  var ro = !canEdit ? 'disabled' : '';
%>
<a class="link-back" href="/pizarra/t/<%= team.id %>/entrenos">← Volver a entrenamientos</a>

<div class="form-card" style="max-width:720px">
  <h1>Asistencia · <%= fechaLarga(session.date) %></h1>
  <p class="hint"><%= session.place||'' %><% if(session.start_time){ %> · <%= session.start_time %><%= session.end_time?('–'+session.end_time):'' %><% } %> · <%= team.name %></p>
  <div id="okMsg" class="hint" style="display:none;color:#1f9b57;font-weight:700">✓ Asistencia guardada.</div>

  <form method="post" action="/pizarra/t/<%= team.id %>/entrenos/<%= session.id %>/asistencia">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% if (canEdit) { %>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin:6px 0 14px">
      <button type="button" class="btn ghost sm" data-all="present">Todos presentes</button>
      <button type="button" class="btn ghost sm" data-all="absent">Todos ausentes</button>
    </div>
    <% } %>
    <% if (!players.length) { %>
      <p class="muted">Este equipo no tiene jugadores en su roster<% if (!team.linked_plantel) { %> (agrégalos en la pizarra)<% } %>.</p>
    <% } else { %>
    <div style="overflow-x:auto">
      <table class="tbl att-tbl">
        <thead><tr><th>#</th><th>Jugador</th><th style="text-align:center">Presente</th><th style="text-align:center">Justificado</th><th style="text-align:center">Ausente</th></tr></thead>
        <tbody>
          <% players.forEach(function(p){ var cur = marks[p.id] || 'present'; %>
          <tr>
            <td class="muted"><%= p.num || '' %></td><td><%= p.name %></td>
            <td style="text-align:center"><input type="radio" name="st_<%= p.id %>" value="present"   <%= cur==='present'?'checked':'' %> <%= ro %>></td>
            <td style="text-align:center"><input type="radio" name="st_<%= p.id %>" value="justified" <%= cur==='justified'?'checked':'' %> <%= ro %>></td>
            <td style="text-align:center"><input type="radio" name="st_<%= p.id %>" value="absent"    <%= cur==='absent'?'checked':'' %> <%= ro %>></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (canEdit) { %>
    <div style="margin-top:16px;display:flex;gap:10px;align-items:center">
      <button class="btn primary">Guardar asistencia</button>
      <a class="btn ghost" href="/pizarra/t/<%= team.id %>/entrenos">Volver</a>
    </div>
    <% } %>
    <% } %>
  </form>
</div>
<%- include('partials/asist-foot') %>
