<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Entrenos' %> · <%= team.name %></title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="/css/styles.css?v=<%= typeof assetVer !== 'undefined' ? assetVer : '1' %>">
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/asistencia.js?v=<%= typeof assetVer !== 'undefined' ? assetVer : '1' %>" defer></script>
  <style>:root{ --primary: <%= /^#[0-9a-fA-F]{3,8}$/.test(s.primary) ? s.primary : '#1f9b57' %>; }</style>
</head>
<body class="admin">
<header class="adm-head">
  <div class="wrap adm-head-inner">
    <a class="brand" href="/pizarra">
      <span class="brand-mark"><svg viewBox="0 0 48 48"><g fill="currentColor"><ellipse cx="24" cy="31" rx="11" ry="9"/><ellipse cx="12" cy="19" rx="4" ry="5.5"/><ellipse cx="20" cy="14" rx="4" ry="6"/><ellipse cx="28" cy="14" rx="4" ry="6"/><ellipse cx="36" cy="19" rx="4" ry="5.5"/></g></svg></span>
      <span class="brand-txt"><b><%= team.name %></b><small><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Pizarra' %></small></span>
    </a>
    <nav class="adm-nav">
      <a href="/pizarra/t/<%= team.id %>/entrenos">Entrenos</a>
      <a href="/pizarra/t/<%= team.id %>/partidos">Partidos</a>
      <a href="/pizarra">← Pizarra</a>
      <% if (typeof coach !== 'undefined' && coach) { %><span class="adm-user"><%= coach.name || coach.username %></span><% } %>
      <form method="post" action="/pizarra/logout" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost sm">Salir</button></form>
    </nav>
  </div>
</header>
<main class="adm-main"><div class="wrap">
<% if (typeof canEdit !== 'undefined' && !canEdit) { %>
<div style="background:#f0982a;color:#221a08;font-weight:600;text-align:center;padding:6px 10px;border-radius:8px;margin-bottom:12px">Solo lectura — este equipo es de otra cuenta.</div>
<% } %>
