<% var pageTitle = player ? 'Editar jugador' : 'Nuevo jugador' %>
<%- include('../partials/admin-head') %>
<a class="link-back" href="/admin/panel">← Volver al panel</a>
<form class="form-card" method="post" action="/admin/jugadores<%= player ? '/' + player.id : '' %>" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h1><%= player ? 'Editar jugador' : 'Nuevo jugador' %></h1>
  <div class="field">
    <label>Nombre</label>
    <input type="text" name="name" required value="<%= player ? player.name : '' %>">
  </div>
  <div class="row2">
    <div class="field"><label>Número</label><input type="text" name="number" maxlength="3" value="<%= player ? player.number : '' %>"></div>
    <div class="field"><label>Posición</label>
      <select name="position">
        <% var positions=['','Base','Escolta','Alero','Ala-pívot','Pívot']; positions.forEach(function(pos){ %>
          <option value="<%= pos %>" <%= player && player.position===pos ? 'selected':'' %>><%= pos || '—' %></option>
        <% }) %>
      </select>
    </div>
  </div>
  <div class="row2">
    <div class="field"><label>Estatura</label><input type="text" name="height" placeholder="1.85 m" value="<%= player ? player.height : '' %>"></div>
    <div class="field"><label>Fecha de nacimiento</label><input type="date" name="birthdate" value="<%= player ? player.birthdate : '' %>"></div>
  </div>
  <div class="field">
    <label>Foto</label>
    <input type="file" name="image" accept="image/*">
    <% if (player && player.photo) { %><input type="hidden" name="photo" value="<%= player.photo %>"><img class="cur-img" src="<%= player.photo %>" alt=""><div class="hint">Sube una nueva para reemplazarla.</div><% } %>
  </div>
  <div class="field">
    <label>Bio / notas</label>
    <textarea name="bio" placeholder="Reseña del jugador (opcional). Admite Markdown."><%= player ? player.bio : '' %></textarea>
  </div>
  <div class="row2">
    <div class="field"><label>Orden</label><input type="number" name="sort" value="<%= player ? player.sort : 0 %>"><div class="hint">Menor = aparece primero.</div></div>
    <div class="field"><label>Rol (cuerpo técnico)</label><input type="text" name="staff_role" placeholder="Entrenador, Asistente…" value="<%= player ? player.staff_role : '' %>"><div class="hint">Solo si es cuerpo técnico.</div></div>
  </div>
  <div class="row2">
    <div class="field check" style="align-self:center;margin-bottom:8px">
      <input type="checkbox" id="act" name="active" value="1" <%= (!player || player.active) ? 'checked':'' %>>
      <label for="act" style="margin:0">Activo</label>
    </div>
    <div class="field check" style="align-self:center;margin-bottom:8px">
      <input type="checkbox" id="stf" name="staff" value="1" <%= (player && player.staff) ? 'checked':'' %>>
      <label for="stf" style="margin:0">Es cuerpo técnico (no jugador)</label>
    </div>
  </div>
  <div class="form-actions">
    <button class="btn primary">Guardar</button>
    <a class="btn ghost" href="/admin/panel">Cancelar</a>
  </div>
</form>
<%- include('../partials/admin-foot') %>
