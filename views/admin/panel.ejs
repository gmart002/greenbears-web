<% var pageTitle = 'Contenido' %>
<%- include('../partials/admin-head') %>

<div class="panel-grid">

  <!-- Visitas -->
  <section class="panel-sec visits-sec">
    <header><h2>Visitas</h2>
      <form method="post" action="/admin/visitas/reiniciar" onsubmit="return confirm('¿Reiniciar el contador de visitas a cero? Esto borra el historial.')">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost sm">Reiniciar</button>
      </form>
    </header>
    <div class="stat-row">
      <div class="stat"><b><%= visits.totalVisits.toLocaleString('es-CL') %></b><span>Visitas totales</span></div>
      <div class="stat"><b><%= visits.todayVisits.toLocaleString('es-CL') %></b><span>Hoy</span></div>
      <div class="stat"><b><%= visits.week.toLocaleString('es-CL') %></b><span>Últimos 7 días</span></div>
      <div class="stat"><b><%= visits.month.toLocaleString('es-CL') %></b><span>Últimos 30 días</span></div>
      <div class="stat"><b><%= visits.totalViews.toLocaleString('es-CL') %></b><span>Páginas vistas</span></div>
    </div>
    <% if (visits.days.length) { var vmax = Math.max(1, ...visits.days.map(function(d){return d.visits;})); %>
    <div class="spark" aria-label="Visitas de los últimos 14 días">
      <% visits.days.slice().reverse().forEach(function(d){ %>
        <span class="spark-bar" style="height:<%= Math.round(4 + (d.visits / vmax) * 52) %>px" title="<%= d.day %>: <%= d.visits %> visitas · <%= d.views %> vistas"></span>
      <% }) %>
    </div>
    <div class="muted sm" style="margin-top:6px">Últimos 14 días · una “visita” cuenta una vez por persona al día.</div>
    <% } else { %><div class="muted sm">Aún no hay visitas registradas.</div><% } %>
  </section>

  <!-- Noticias -->
  <section class="panel-sec">
    <header><h2>Noticias</h2><a class="btn primary sm" href="/admin/noticias/nueva">+ Nueva noticia</a></header>
    <table class="tbl">
      <thead><tr><th>Título</th><th class="hide-sm">Fecha</th><th>Estado</th><th></th></tr></thead>
      <tbody>
        <% if (!posts.length) { %><tr class="empty-row"><td colspan="4">Sin noticias todavía.</td></tr><% } %>
        <% posts.forEach(function(p){ %>
        <tr>
          <td><b><%= p.title %></b></td>
          <td class="hide-sm muted"><%= new Date(p.created_at).toLocaleDateString('es-CL') %></td>
          <td><span class="pill <%= p.published ? 'on':'off' %>"><%= p.published ? 'Publicada':'Borrador' %></span></td>
          <td><div class="actions">
            <a class="btn ghost sm" href="/admin/noticias/<%= p.id %>/editar">Editar</a>
            <form method="post" action="/admin/noticias/<%= p.id %>/eliminar" onsubmit="return confirm('¿Eliminar esta noticia?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">×</button></form>
          </div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>

  <!-- Jugadores -->
  <section class="panel-sec">
    <header><h2>Jugadores</h2><a class="btn primary sm" href="/admin/jugadores/nuevo">+ Nuevo jugador</a></header>
    <table class="tbl">
      <thead><tr><th></th><th>Nombre</th><th class="hide-sm">Posición</th><th>Estado</th><th></th></tr></thead>
      <tbody>
        <% if (!players.length) { %><tr class="empty-row"><td colspan="5">Sin jugadores todavía.</td></tr><% } %>
        <% players.forEach(function(pl){ %>
        <tr>
          <td><% if (pl.photo) { %><img class="thumb-sm" src="<%= pl.photo %>" alt=""><% } else { %><div class="thumb-sm"></div><% } %></td>
          <td><b><% if (pl.number) { %>#<%= pl.number %> <% } %><%= pl.name %></b></td>
          <td class="hide-sm muted"><%= pl.position %></td>
          <td><span class="pill <%= pl.active ? 'on':'off' %>"><%= pl.active ? 'Activo':'Inactivo' %></span></td>
          <td><div class="actions">
            <a class="btn ghost sm" href="/admin/jugadores/<%= pl.id %>/editar">Editar</a>
            <form method="post" action="/admin/jugadores/<%= pl.id %>/eliminar" onsubmit="return confirm('¿Eliminar a este jugador?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">×</button></form>
          </div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>

  <!-- Partidos -->
  <section class="panel-sec">
    <header><h2>Partidos</h2><a class="btn primary sm" href="/admin/partidos/nuevo">+ Nuevo partido</a></header>
    <table class="tbl">
      <thead><tr><th>Rival</th><th class="hide-sm">Fecha</th><th>Marcador</th><th></th></tr></thead>
      <tbody>
        <% if (!matches.length) { %><tr class="empty-row"><td colspan="4">Sin partidos todavía.</td></tr><% } %>
        <% matches.forEach(function(m){ %>
        <tr>
          <td><b><%= m.opponent %></b> <span class="pill <%= m.status==='played'?'on':'off' %>"><%= m.status==='played'?'Jugado':'Próximo' %></span></td>
          <td class="hide-sm muted"><%= new Date(m.date).toLocaleString('es-CL',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) %></td>
          <td><% if (m.status==='played') { %><b><%= m.our_score %> – <%= m.opp_score %></b><% } else { %><span class="muted">—</span><% } %></td>
          <td><div class="actions">
            <a class="btn ghost sm" href="/admin/partidos/<%= m.id %>/editar">Editar</a>
            <form method="post" action="/admin/partidos/<%= m.id %>/eliminar" onsubmit="return confirm('¿Eliminar este partido?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">×</button></form>
          </div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>

  <!-- Galería -->
  <section class="panel-sec" id="galeria">
    <header><h2>Galería</h2><a class="btn primary sm" href="/admin/galeria/nueva">+ Agregar foto/video</a></header>
    <table class="tbl">
      <thead><tr><th></th><th>Título</th><th class="hide-sm">Temporada</th><th>Tipo</th><th></th></tr></thead>
      <tbody>
        <% if (!gallery.length) { %><tr class="empty-row"><td colspan="5">Sin elementos todavía.</td></tr><% } %>
        <% gallery.forEach(function(it){ %>
        <tr>
          <td><% if (it.image) { %><img class="thumb-sm" src="<%= it.image %>" alt=""><% } else { %><div class="thumb-sm"></div><% } %></td>
          <td><b><%= it.title || '(sin título)' %></b></td>
          <td class="hide-sm muted"><%= it.season %></td>
          <td><span class="pill on"><%= it.video_url ? 'Video' : 'Foto' %></span></td>
          <td><div class="actions">
            <a class="btn ghost sm" href="/admin/galeria/<%= it.id %>/editar">Editar</a>
            <form method="post" action="/admin/galeria/<%= it.id %>/eliminar" onsubmit="return confirm('¿Eliminar?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">×</button></form>
          </div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>

  <!-- Patrocinadores -->
  <section class="panel-sec" id="patrocinadores">
    <header><h2>Patrocinadores</h2></header>
    <table class="tbl">
      <thead><tr><th></th><th>Nombre</th><th class="hide-sm">Enlace</th><th></th></tr></thead>
      <tbody>
        <% if (!sponsors.length) { %><tr class="empty-row"><td colspan="4">Sin patrocinadores.</td></tr><% } %>
        <% sponsors.forEach(function(sp){ %>
        <tr>
          <td><% if (sp.logo) { %><img class="thumb-sm" src="<%= sp.logo %>" alt=""><% } else { %><div class="thumb-sm"></div><% } %></td>
          <td><b><%= sp.name %></b></td>
          <td class="hide-sm muted" style="max-width:220px;overflow:hidden;text-overflow:ellipsis"><%= sp.url %></td>
          <td><div class="actions"><form method="post" action="/admin/patrocinadores/<%= sp.id %>/eliminar" onsubmit="return confirm('¿Eliminar?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">×</button></form></div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <form method="post" action="/admin/patrocinadores" enctype="multipart/form-data" style="display:flex;gap:10px;flex-wrap:wrap;align-items:end;padding:14px 20px;border-top:1px solid var(--line)">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field" style="margin:0"><label>Nombre</label><input type="text" name="name" required></div>
      <div class="field" style="margin:0"><label>Enlace (opcional)</label><input type="text" name="url" placeholder="https://"></div>
      <div class="field" style="margin:0"><label>Logo</label><input type="file" name="logo" accept="image/*"></div>
      <button class="btn primary sm">Agregar</button>
    </form>
  </section>

  <!-- Mensajes -->
  <section class="panel-sec" id="mensajes">
    <header><h2>Mensajes de contacto</h2></header>
    <table class="tbl">
      <thead><tr><th>De</th><th class="hide-sm">Contacto</th><th>Mensaje</th><th></th></tr></thead>
      <tbody>
        <% if (!messages.length) { %><tr class="empty-row"><td colspan="4">Sin mensajes.</td></tr><% } %>
        <% messages.forEach(function(mm){ %>
        <tr style="<%= mm.read ? 'opacity:.6' : '' %>">
          <td><b><%= mm.name %></b><br><span class="muted" style="font-size:.8rem"><%= mm.reason %> · <%= new Date(mm.created_at).toLocaleDateString('es-CL') %></span></td>
          <td class="hide-sm"><%= mm.contact %></td>
          <td style="max-width:360px"><%= mm.body %></td>
          <td><div class="actions">
            <% if (!mm.read) { %><form method="post" action="/admin/mensajes/<%= mm.id %>/leido"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost sm">Leído</button></form><% } %>
            <form method="post" action="/admin/mensajes/<%= mm.id %>/eliminar" onsubmit="return confirm('¿Eliminar?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">×</button></form>
          </div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>

</div>
<%- include('../partials/admin-foot') %>
