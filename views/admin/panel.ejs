<% var pageTitle = 'Contenido' %>
<%- include('../partials/admin-head') %>

<div class="panel-grid">

  <% if (isSuper) { %>
  <!-- Visitas -->
  <section class="panel-sec visits-sec">
    <header><h2>Visitas</h2>
      <div class="actions">
        <a class="btn ghost sm" href="/admin/visitas.csv">Descargar detalle (CSV)</a>
        <form method="post" action="/admin/visitas/reiniciar" onsubmit="return confirm('¿Reiniciar el contador de visitas a cero? Esto borra el historial.')">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost sm">Reiniciar</button>
        </form>
      </div>
    </header>
    <div class="stat-row">
      <div class="stat"><b><%= visits.totalVisits.toLocaleString('es-CL') %></b><span>Visitas totales</span></div>
      <div class="stat"><b><%= visits.todayVisits.toLocaleString('es-CL') %></b><span>Hoy</span></div>
      <div class="stat"><b><%= visits.week.toLocaleString('es-CL') %></b><span>Últimos 7 días</span></div>
      <div class="stat"><b><%= visits.month.toLocaleString('es-CL') %></b><span>Últimos 30 días</span></div>
      <div class="stat"><b><%= visits.totalViews.toLocaleString('es-CL') %></b><span>Páginas vistas</span></div>
    </div>
    <% if (visits.days.length) { var vmax = Math.max(1, ...visits.days.map(function(d){return d.visits;})); %>
    <div class="spark" aria-label="Visitas de los últimos 14 días">
      <% visits.days.slice().reverse().forEach(function(d){ %>
        <span class="spark-bar" style="height:<%= Math.round(4 + (d.visits / vmax) * 52) %>px" title="<%= d.day %>: <%= d.visits %> visitas · <%= d.views %> vistas"></span>
      <% }) %>
    </div>
    <div class="muted sm" style="margin-top:6px">Últimos 14 días · una “visita” cuenta una vez por persona al día.</div>
    <table class="tbl" style="margin-top:14px">
      <thead><tr><th>Fecha</th><th>Visitas</th><th>Páginas vistas</th></tr></thead>
      <tbody>
        <% visits.days.forEach(function(d){ %>
        <tr><td><%= d.day %></td><td><b><%= d.visits %></b></td><td class="muted"><%= d.views %></td></tr>
        <% }) %>
      </tbody>
    </table>
    <% } else { %><div class="muted sm">Aún no hay visitas registradas.</div><% } %>
  </section>
  <% } %>

  <% if (can('noticias')) { %>
  <!-- Noticias -->
  <section class="panel-sec">
    <header><h2>Noticias</h2><a class="btn primary sm" href="/admin/noticias/nueva">+ Nueva noticia</a></header>
    <table class="tbl">
      <thead><tr><th>Título</th><th class="hide-sm">Fecha</th><th>Estado</th><th></th></tr></thead>
      <tbody>
        <% if (!posts.length) { %><tr class="empty-row"><td colspan="4">Sin noticias todavía.</td></tr><% } %>
        <% posts.forEach(function(p){ %>
        <tr>
          <td><b><%= p.title %></b></td>
          <td class="hide-sm muted"><%= new Date(p.created_at).toLocaleDateString('es-CL') %></td>
          <td><span class="pill <%= p.published ? 'on':'off' %>"><%= p.published ? 'Publicada':'Borrador' %></span></td>
          <td><div class="actions">
            <a class="btn ghost sm" href="/admin/noticias/<%= p.id %>/editar">Editar</a>
            <form method="post" action="/admin/noticias/<%= p.id %>/eliminar" onsubmit="return confirm('¿Eliminar esta noticia?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">×</button></form>
          </div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
  <% } %>

  <% if (can('jugadores')) { %>
  <!-- Jugadores -->
  <section class="panel-sec">
    <header><h2>Jugadores</h2><a class="btn primary sm" href="/admin/jugadores/nuevo">+ Nuevo jugador</a></header>
    <table class="tbl">
      <thead><tr><th></th><th>Nombre</th><th class="hide-sm">Posición</th><th>Estado</th><th></th></tr></thead>
      <tbody>
        <% if (!players.length) { %><tr class="empty-row"><td colspan="5">Sin jugadores todavía.</td></tr><% } %>
        <% players.forEach(function(pl){ %>
        <tr>
          <td><% if (pl.photo) { %><img class="thumb-sm" src="<%= pl.photo %>" alt=""><% } else { %><div class="thumb-sm"></div><% } %></td>
          <td><b><% if (pl.number) { %>#<%= pl.number %> <% } %><%= pl.name %></b></td>
          <td class="hide-sm muted"><%= pl.position %></td>
          <td><span class="pill <%= pl.active ? 'on':'off' %>"><%= pl.active ? 'Activo':'Inactivo' %></span></td>
          <td><div class="actions">
            <a class="btn ghost sm" href="/admin/jugadores/<%= pl.id %>/editar">Editar</a>
            <form method="post" action="/admin/jugadores/<%= pl.id %>/eliminar" onsubmit="return confirm('¿Eliminar a este jugador?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">×</button></form>
          </div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
  <% } %>

  <% if (can('lbo')) { %>
  <!-- Liga LBO -->
  <section class="panel-sec">
    <header><h2>Liga LBO 2026</h2><a class="btn primary sm" href="/admin/lbo">Cargar resultados / tabla</a></header>
    <div class="muted sm" style="padding:0 20px 16px">Carga los marcadores de la liga; la tabla de posiciones se calcula según las bases y el próximo partido de Green Bears se publica solo en el sitio.</div>
  </section>
  <% } %>

  <% if (can('partidos')) { %>
  <!-- Partidos -->
  <section class="panel-sec">
    <header><h2>Partidos</h2><a class="btn primary sm" href="/admin/partidos/nuevo">+ Nuevo partido</a></header>
    <table class="tbl">
      <thead><tr><th>Rival</th><th class="hide-sm">Fecha</th><th>Marcador</th><th></th></tr></thead>
      <tbody>
        <% if (!matches.length) { %><tr class="empty-row"><td colspan="4">Sin partidos todavía.</td></tr><% } %>
        <% matches.forEach(function(m){ %>
        <tr>
          <td><b><%= m.opponent %></b> <span class="pill <%= m.status==='played'?'on':'off' %>"><%= m.status==='played'?'Jugado':'Próximo' %></span></td>
          <td class="hide-sm muted"><%= new Date(m.date).toLocaleString('es-CL',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) %></td>
          <td><% if (m.status==='played') { %><b><%= m.our_score %> – <%= m.opp_score %></b><% } else { %><span class="muted">—</span><% } %></td>
          <td><div class="actions">
            <a class="btn ghost sm" href="/admin/partidos/<%= m.id %>/editar">Editar</a>
            <form method="post" action="/admin/partidos/<%= m.id %>/eliminar" onsubmit="return confirm('¿Eliminar este partido?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">×</button></form>
          </div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
  <% } %>

  <% if (can('galeria')) { %>
  <!-- Galería -->
  <section class="panel-sec" id="galeria">
    <header><h2>Galería</h2><a class="btn primary sm" href="/admin/galeria/nueva">+ Agregar foto/video</a></header>
    <table class="tbl">
      <thead><tr><th></th><th>Título</th><th class="hide-sm">Temporada</th><th>Tipo</th><th></th></tr></thead>
      <tbody>
        <% if (!gallery.length) { %><tr class="empty-row"><td colspan="5">Sin elementos todavía.</td></tr><% } %>
        <% gallery.forEach(function(it){ %>
        <tr>
          <td><% if (it.image) { %><img class="thumb-sm" src="<%= it.image %>" alt=""><% } else { %><div class="thumb-sm"></div><% } %></td>
          <td><b><%= it.title || '(sin título)' %></b></td>
          <td class="hide-sm muted"><%= it.season %></td>
          <td><span class="pill on"><%= it.video_url ? 'Video' : 'Foto' %></span></td>
          <td><div class="actions">
            <a class="btn ghost sm" href="/admin/galeria/<%= it.id %>/editar">Editar</a>
            <form method="post" action="/admin/galeria/<%= it.id %>/eliminar" onsubmit="return confirm('¿Eliminar?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">×</button></form>
          </div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
  <% } %>

  <% if (can('highlights')) { %>
  <!-- Highlights -->
  <section class="panel-sec" id="highlights">
    <header><h2>Highlights</h2><a class="btn primary sm" href="/admin/highlights/nuevo">+ Agregar highlight</a></header>
    <table class="tbl">
      <thead><tr><th>Título</th><th class="hide-sm">Tipo</th><th class="hide-sm">Orden</th><th></th></tr></thead>
      <tbody>
        <% if (!highlights.length) { %><tr class="empty-row"><td colspan="4">Sin highlights todavía.</td></tr><% } %>
        <% highlights.forEach(function(h){ %>
        <tr>
          <td><b><%= h.title || '(sin título)' %></b></td>
          <td class="hide-sm"><span class="pill on"><%= h.video ? 'Video subido' : (h.video_url ? 'Enlace' : '—') %></span></td>
          <td class="hide-sm muted"><%= h.sort %></td>
          <td><div class="actions">
            <a class="btn ghost sm" href="/admin/highlights/<%= h.id %>/editar">Editar</a>
            <form method="post" action="/admin/highlights/<%= h.id %>/eliminar" onsubmit="return confirm('¿Eliminar este highlight?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">×</button></form>
          </div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
  <% } %>

  <% if (can('patrocinadores')) { %>
  <!-- Patrocinadores -->
  <section class="panel-sec" id="patrocinadores">
    <header><h2>Patrocinadores</h2></header>
    <table class="tbl">
      <thead><tr><th></th><th>Nombre</th><th class="hide-sm">Enlace</th><th></th></tr></thead>
      <tbody>
        <% if (!sponsors.length) { %><tr class="empty-row"><td colspan="4">Sin patrocinadores.</td></tr><% } %>
        <% sponsors.forEach(function(sp){ %>
        <tr>
          <td><% if (sp.logo) { %><img class="thumb-sm" src="<%= sp.logo %>" alt=""><% } else { %><div class="thumb-sm"></div><% } %></td>
          <td><b><%= sp.name %></b></td>
          <td class="hide-sm muted" style="max-width:220px;overflow:hidden;text-overflow:ellipsis"><%= sp.url %></td>
          <td><div class="actions"><form method="post" action="/admin/patrocinadores/<%= sp.id %>/eliminar" onsubmit="return confirm('¿Eliminar?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">×</button></form></div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <form method="post" action="/admin/patrocinadores" enctype="multipart/form-data" style="display:flex;gap:10px;flex-wrap:wrap;align-items:end;padding:14px 20px;border-top:1px solid var(--line)">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field" style="margin:0"><label>Nombre</label><input type="text" name="name" required></div>
      <div class="field" style="margin:0"><label>Enlace (opcional)</label><input type="text" name="url" placeholder="https://"></div>
      <div class="field" style="margin:0"><label>Logo</label><input type="file" name="logo" accept="image/*"></div>
      <button class="btn primary sm">Agregar</button>
    </form>
  </section>
  <% } %>

  <% if (can('mensajes')) { %>
  <!-- Mensajes -->
  <section class="panel-sec" id="mensajes">
    <header><h2>Mensajes de contacto</h2></header>
    <table class="tbl">
      <thead><tr><th>De</th><th class="hide-sm">Contacto</th><th>Mensaje</th><th></th></tr></thead>
      <tbody>
        <% if (!messages.length) { %><tr class="empty-row"><td colspan="4">Sin mensajes.</td></tr><% } %>
        <% messages.forEach(function(mm){ %>
        <tr style="<%= mm.read ? 'opacity:.6' : '' %>">
          <td><b><%= mm.name %></b><br><span class="muted" style="font-size:.8rem"><%= mm.reason %> · <%= new Date(mm.created_at).toLocaleDateString('es-CL') %></span></td>
          <td class="hide-sm"><%= mm.contact %></td>
          <td style="max-width:360px"><%= mm.body %></td>
          <td><div class="actions">
            <% if (!mm.read) { %><form method="post" action="/admin/mensajes/<%= mm.id %>/leido"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost sm">Leído</button></form><% } %>
            <form method="post" action="/admin/mensajes/<%= mm.id %>/eliminar" onsubmit="return confirm('¿Eliminar?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">×</button></form>
          </div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
  <% } %>

  <!-- Usuarios (solo superadmin) -->
  <% if (isSuper) { %>
  <section class="panel-sec" id="usuarios">
    <header><h2>Usuarios</h2><span class="muted sm">Tú eres el superadmin. Crea editores para que gestionen contenido.</span></header>
    <table class="tbl">
      <thead><tr><th>Usuario</th><th>Rol</th><th>Estado</th><th></th></tr></thead>
      <tbody>
        <% users.forEach(function(u){ %>
        <tr>
          <td><b><%= u.username %></b><% if (u.id === uid) { %> <span class="muted sm">(tú)</span><% } %></td>
          <td><span class="pill <%= u.role === 'super' ? 'on' : 'off' %>"><%= u.role === 'super' ? 'Superadmin' : 'Editor' %></span><% if (u.role !== 'super') { %><div class="muted sm"><%= String(u.perms||'').split(',').filter(Boolean).length %> módulos</div><% } %></td>
          <td><span class="pill <%= u.active ? 'on' : 'off' %>"><%= u.active ? 'Activo' : 'Inactivo' %></span></td>
          <td><div class="actions">
            <% if (u.role !== 'super') { %><a class="btn ghost sm" href="/admin/usuarios/<%= u.id %>/permisos">Permisos</a><% } %>
            <form method="post" action="/admin/usuarios/<%= u.id %>/clave" onsubmit="this.password.value=prompt('Nueva clave para <%= u.username %> (mín. 6):')||''; return !!this.password.value">
              <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="password"><button class="btn ghost sm">Cambiar clave</button>
            </form>
            <% if (u.id !== uid) { %>
              <form method="post" action="/admin/usuarios/<%= u.id %>/estado"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="active" value="<%= u.active ? 0 : 1 %>"><button class="btn ghost sm"><%= u.active ? 'Desactivar' : 'Activar' %></button></form>
              <form method="post" action="/admin/usuarios/<%= u.id %>/eliminar" onsubmit="return confirm('¿Eliminar a <%= u.username %>?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">×</button></form>
            <% } %>
          </div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <form method="post" action="/admin/usuarios" style="display:flex;gap:10px;flex-wrap:wrap;align-items:end;padding:14px 20px;border-top:1px solid var(--line)">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field" style="margin:0"><label>Usuario</label><input type="text" name="username" placeholder="ej: entrenador" autocapitalize="none" required></div>
      <div class="field" style="margin:0"><label>Clave (mín. 6)</label><input type="text" name="password" required></div>
      <div class="field" style="margin:0"><label>Rol</label>
        <select name="role"><option value="editor">Editor (gestiona contenido)</option><option value="super">Superadmin (todo)</option></select>
      </div>
      <div class="field" style="margin:0;flex-basis:100%"><label>Permisos del editor (módulos)</label>
        <div style="display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:4px">
          <% MODULES.forEach(function(m){ %><label class="check-line" style="font-weight:500"><input type="checkbox" name="perms" value="<%= m[0] %>" checked> <%= m[1] %></label><% }) %>
        </div>
        <div class="hint">Aplica solo si el rol es Editor. El Superadmin siempre tiene todo.</div>
      </div>
      <button class="btn primary sm">Crear usuario</button>
    </form>
    <div class="muted sm" style="padding:0 20px 16px">Cada <b>editor</b> entra solo a los módulos que le asignes. La configuración del sitio, los usuarios y los coaches son solo para <b>superadmin</b>. Ajusta los módulos de un editor con el botón <b>Permisos</b>.</div>
  </section>
  <% } %>

  <!-- Coaches de la pizarra (solo superadmin) -->
  <% if (isSuper) { %>
  <section class="panel-sec" id="coaches">
    <header><h2>Coaches (pizarra)</h2><span class="muted sm">Cuentas para entrar a la pizarra táctica. Cada coach gestiona sus propios equipos y jugadas.</span></header>
    <table class="tbl">
      <thead><tr><th>Usuario</th><th class="hide-sm">Nombre</th><th>Equipos</th><th>Estado</th><th></th></tr></thead>
      <tbody>
        <% if (!coaches.length) { %><tr class="empty-row"><td colspan="5">Aún no hay coaches.</td></tr><% } %>
        <% coaches.forEach(function(c){ %>
        <tr>
          <td><b><%= c.username %></b><% if (c.role === 'super') { %> <span class="pill on" style="font-size:.68rem">SUPER</span><% } %></td>
          <td class="hide-sm muted"><%= c.name %></td>
          <td><%= c.teams %></td>
          <td><span class="pill <%= c.active ? 'on' : 'off' %>"><%= c.active ? 'Activo' : 'Inactivo' %></span></td>
          <td><div class="actions">
            <form method="post" action="/admin/coaches/<%= c.id %>/clave" onsubmit="this.password.value=prompt('Nueva clave para <%= c.username %> (mín. 6):')||''; return !!this.password.value">
              <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="password"><button class="btn ghost sm">Cambiar clave</button>
            </form>
            <form method="post" action="/admin/coaches/<%= c.id %>/rol"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="role" value="<%= c.role === 'super' ? 'coach' : 'super' %>"><button class="btn ghost sm"><%= c.role === 'super' ? 'Quitar super' : 'Hacer super' %></button></form>
            <form method="post" action="/admin/coaches/<%= c.id %>/estado"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="active" value="<%= c.active ? 0 : 1 %>"><button class="btn ghost sm"><%= c.active ? 'Desactivar' : 'Activar' %></button></form>
            <form method="post" action="/admin/coaches/<%= c.id %>/eliminar" onsubmit="return confirm('¿Eliminar al coach <%= c.username %>? Se borran sus equipos y jugadas.')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">×</button></form>
          </div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <form method="post" action="/admin/coaches" style="display:flex;gap:10px;flex-wrap:wrap;align-items:end;padding:14px 20px;border-top:1px solid var(--line)">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field" style="margin:0"><label>Usuario</label><input type="text" name="username" placeholder="ej: coach.mauro" autocapitalize="none" required></div>
      <div class="field" style="margin:0"><label>Nombre (opcional)</label><input type="text" name="name" placeholder="Mauro Rebolledo"></div>
      <div class="field" style="margin:0"><label>Clave (mín. 6)</label><input type="text" name="password" required></div>
      <label class="field" style="margin:0;display:flex;align-items:center;gap:6px;flex-direction:row"><input type="checkbox" name="role" value="super" style="width:auto"> Superadmin</label>
      <button class="btn primary sm">Crear coach</button>
    </form>
  </section>
  <% } %>

</div>
<%- include('../partials/admin-foot') %>
