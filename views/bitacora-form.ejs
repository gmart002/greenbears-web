<% var pageTitle = 'Bitácora' %>
<%- include('partials/asist-head') %>
<%
  function fechaLarga(iso){
    if(!iso) return '';
    var d = new Date(iso + 'T12:00:00');
    var dias=['domingo','lunes','martes','miércoles','jueves','viernes','sábado'];
    var mes=['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
    return dias[d.getDay()]+' '+d.getDate()+' de '+mes[d.getMonth()]+' '+d.getFullYear();
  }
  function A(v){ return v==null?'':String(v); }              // valor seguro
  var objs = data.objetivos||[], ev = data.evaluacion||{}, an = data.analisis||{}, cma = data.cma||{}, ideas = data.ideas||{}, prox = data.proxima||[];
  var inp = 'width:100%;padding:8px;border:1px solid var(--line);border-radius:8px;box-sizing:border-box';
  var ta  = inp+';min-height:64px;resize:vertical;font-family:inherit';
%>
<a class="link-back" href="/asistencia">← Volver a entrenamientos</a>

<form method="post" action="/asistencia/<%= session.id %>/bitacora">
  <input type="hidden" name="_csrf" value="<%= csrf %>">

  <div class="form-card" style="max-width:900px">
    <div style="display:flex;justify-content:space-between;align-items:start;gap:12px;flex-wrap:wrap">
      <div>
        <h1 style="margin-bottom:2px">Bitácora de entrenamiento</h1>
        <p class="hint" style="margin:0"><b><%= fechaLarga(session.date) %></b> · <%= session.place||'' %><% if(session.start_time){ %> · <%= session.start_time %><%= session.end_time?('–'+session.end_time):'' %><% } %></p>
      </div>
      <a class="btn ghost sm" href="/asistencia/<%= session.id %>/bitacora/print" target="_blank">Imprimir / PDF</a>
    </div>
    <div id="okMsg" class="hint" style="display:none;color:#1f9b57;font-weight:700;margin-top:8px">✓ Bitácora guardada.</div>

    <!-- Datos de la sesión -->
    <h2 style="margin-top:18px">Datos de la sesión</h2>
    <div class="bit-grid">
      <label>Categoría<input name="categoria" value="<%= A(data.categoria) %>" style="<%= inp %>"></label>
      <label>Duración<input name="duracion" value="<%= A(data.duracion) %>" placeholder="ej. 2 horas" style="<%= inp %>"></label>
      <label>Entrenador<input name="entrenador" value="<%= A(data.entrenador) %>" style="<%= inp %>"></label>
      <label>N.º jugadores<input name="n_jugadores" value="<%= A(data.n_jugadores) %>" style="<%= inp %>"></label>
      <label>Tipo de sesión<input name="tipo_sesion" value="<%= A(data.tipo_sesion) %>" placeholder="ej. Táctica" style="<%= inp %>"></label>
    </div>

    <!-- Identidad -->
    <h2 style="margin-top:18px">Identidad del entrenamiento</h2>
    <div class="bit-grid">
      <label style="grid-column:1/-1">Objetivo general de la sesión<input name="objetivo_general" value="<%= A(data.objetivo_general) %>" style="<%= inp %>"></label>
      <label style="grid-column:1/-1">Concepto / mensaje del día<input name="concepto_dia" value="<%= A(data.concepto_dia) %>" style="<%= inp %>"></label>
    </div>

    <!-- 3 objetivos prioritarios -->
    <h2 style="margin-top:18px">Tres objetivos prioritarios</h2>
    <div style="overflow-x:auto">
      <table class="tbl">
        <thead><tr><th>#</th><th>Objetivo específico</th><th style="text-align:center">¿Se trabajó?</th><th style="text-align:center">¿Se logró?</th><th>Observación</th></tr></thead>
        <tbody>
          <% for (var i=1;i<=3;i++){ var o=objs[i-1]||{}; %>
          <tr>
            <td><b><%= i %></b></td>
            <td><input name="obj_<%= i %>_especifico" value="<%= A(o.especifico) %>" style="<%= inp %>"></td>
            <td style="text-align:center"><input type="checkbox" name="obj_<%= i %>_trabajo" <%= o.trabajo?'checked':'' %>></td>
            <td style="text-align:center"><input type="checkbox" name="obj_<%= i %>_logro" <%= o.logro?'checked':'' %>></td>
            <td><input name="obj_<%= i %>_obs" value="<%= A(o.obs) %>" style="<%= inp %>"></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Evaluación 1-5 -->
    <h2 style="margin-top:18px">Evaluación del entrenamiento</h2>
    <p class="hint">Escala: 1 = muy bajo · 3 = adecuado · 5 = excelente</p>
    <div style="overflow-x:auto">
      <table class="tbl">
        <thead><tr><th>Área</th><th style="text-align:center">1</th><th style="text-align:center">2</th><th style="text-align:center">3</th><th style="text-align:center">4</th><th style="text-align:center">5</th><th>Observación</th></tr></thead>
        <tbody>
          <% areas.forEach(function(a){ var e=ev[a[0]]||{}; %>
          <tr>
            <td><b><%= a[1] %></b></td>
            <% for (var v=1;v<=5;v++){ %><td style="text-align:center"><input type="radio" name="ev_<%= a[0] %>_n" value="<%= v %>" <%= Number(e.n)===v?'checked':'' %>></td><% } %>
            <td><input name="ev_<%= a[0] %>_obs" value="<%= A(e.obs) %>" style="<%= inp %>"></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Análisis del entrenador -->
    <h2 style="margin-top:18px">Análisis del entrenador</h2>
    <div class="bit-grid">
      <label>¿Qué funcionó?<textarea name="an_funciono" style="<%= ta %>"><%= A(an.funciono) %></textarea></label>
      <label>¿Qué no funcionó?<textarea name="an_no_funciono" style="<%= ta %>"><%= A(an.no_funciono) %></textarea></label>
      <label>¿Qué debemos repetir?<textarea name="an_repetir" style="<%= ta %>"><%= A(an.repetir) %></textarea></label>
      <label>¿Qué debemos corregir?<textarea name="an_corregir" style="<%= ta %>"><%= A(an.corregir) %></textarea></label>
      <label>Jugadores que destacaron y por qué<textarea name="an_destacaron" style="<%= ta %>"><%= A(an.destacaron) %></textarea></label>
      <label>Jugadores que necesitan atención individual<textarea name="an_atencion" style="<%= ta %>"><%= A(an.atencion) %></textarea></label>
    </div>

    <!-- Corregir / Mantener / Agregar -->
    <h2 style="margin-top:18px">Corregir · Mantener · Agregar</h2>
    <div class="bit-grid">
      <label>🔴 Corregir<textarea name="cma_corregir" style="<%= ta %>"><%= A(cma.corregir) %></textarea></label>
      <label>🟡 Mantener<textarea name="cma_mantener" style="<%= ta %>"><%= A(cma.mantener) %></textarea></label>
      <label>🟢 Agregar<textarea name="cma_agregar" style="<%= ta %>"><%= A(cma.agregar) %></textarea></label>
    </div>

    <!-- Ideas libres -->
    <h2 style="margin-top:18px">Ideas y observaciones libres</h2>
    <div class="bit-grid">
      <label>Nueva idea / ejercicio / concepto táctico<textarea name="idea_nueva" style="<%= ta %>"><%= A(ideas.idea) %></textarea></label>
      <label>Situación en que podría utilizarse<textarea name="idea_situacion" style="<%= ta %>"><%= A(ideas.situacion) %></textarea></label>
      <label style="grid-column:1/-1">Notas del entrenador<textarea name="idea_notas" style="<%= ta %>"><%= A(ideas.notas) %></textarea></label>
    </div>

    <!-- Próximo entrenamiento -->
    <h2 style="margin-top:18px">Preparación del próximo entrenamiento</h2>
    <div style="overflow-x:auto">
      <table class="tbl">
        <thead><tr><th>#</th><th>Prioridad para la próxima sesión</th><th>Cómo la voy a trabajar</th><th>Indicador de éxito</th></tr></thead>
        <tbody>
          <% for (var j=1;j<=3;j++){ var p=prox[j-1]||{}; %>
          <tr>
            <td><b><%= j %></b></td>
            <td><input name="prox_<%= j %>_prioridad" value="<%= A(p.prioridad) %>" style="<%= inp %>"></td>
            <td><input name="prox_<%= j %>_como" value="<%= A(p.como) %>" style="<%= inp %>"></td>
            <td><input name="prox_<%= j %>_indicador" value="<%= A(p.indicador) %>" style="<%= inp %>"></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div style="margin-top:18px;display:flex;gap:10px;align-items:center">
      <button class="btn primary">Guardar bitácora</button>
      <a class="btn ghost" href="/asistencia">Volver</a>
    </div>
  </div>
</form>

<style>
  .bit-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .bit-grid label{display:flex;flex-direction:column;gap:4px;font-weight:600;font-size:.9rem}
  @media (max-width:640px){ .bit-grid{grid-template-columns:1fr} }
</style>
<%- include('partials/asist-foot') %>
