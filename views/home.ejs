<%- include('partials/header') %>

<section class="hero <%= s.hero_image ? 'has-img' : '' %>" <%= s.hero_image ? 'style=--hero:url(' + s.hero_image + ')' : '' %>>
  <div class="hero-inner">
    <div class="eyebrow"><%= s.tagline %></div>
    <h1><%= s.site_title %></h1>
    <p><%= s.about %></p>
    <div class="actions">
      <a class="btn primary" href="<%= pizarraUrl %>" target="_blank" rel="noopener">Abrir la Pizarra</a>
      <a class="btn light" href="/jugadores">Ver el equipo</a>
    </div>
  </div>
</section>

<% if (nextMatch || lastResults.length) { %>
<section class="section">
  <div class="wrap">
    <div class="grid" style="grid-template-columns:1fr 1fr;align-items:start">
      <% if (nextMatch) { %>
      <div class="matchcard">
        <div class="section-head" style="margin-bottom:12px"><span class="kicker">Próximo partido</span></div>
        <div class="match-teams"><span>Green Bears</span> <span class="muted">vs</span> <span><%= nextMatch.opponent %></span></div>
        <p class="muted" style="margin:10px 0 0"><%= fmtDateTime(nextMatch.date) %><% if (nextMatch.location) { %> · <%= nextMatch.location %><% } %>
          <span class="badge <%= nextMatch.home ? 'home' : '' %>"><%= nextMatch.home ? 'Local' : 'Visita' %></span></p>
      </div>
      <% } %>
      <% if (lastResults.length) { %>
      <div class="matchcard">
        <div class="section-head" style="margin-bottom:6px"><span class="kicker">Últimos resultados</span></div>
        <% lastResults.forEach(function(m){ var win = m.our_score > m.opp_score; %>
          <div class="match-row">
            <div class="match-teams" style="font-size:1rem">vs <%= m.opponent %></div>
            <div class="score"><span class="<%= win ? 'win' : 'loss' %>"><%= m.our_score %></span> <span class="muted">–</span> <%= m.opp_score %></div>
          </div>
        <% }) %>
        <a class="more" href="/calendario">Ver calendario completo →</a>
      </div>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<section class="section alt">
  <div class="wrap">
    <div class="section-head">
      <div><span class="kicker">Al día</span><h2>Noticias</h2></div>
      <a class="btn ghost sm" href="/noticias">Ver todas</a>
    </div>
    <% if (!posts.length) { %>
      <div class="empty-state">Aún no hay noticias publicadas.</div>
    <% } else { %>
    <div class="grid cards">
      <% posts.forEach(function(p){ %>
      <a class="card" href="/noticias/<%= p.slug %>">
        <% if (p.cover) { %><div class="thumb" style="background-image:url(<%= p.cover %>)"></div>
        <% } else { %><div class="thumb ph">Green Bears</div><% } %>
        <div class="body">
          <span class="date"><%= fmtDate(p.created_at) %></span>
          <h3><%= p.title %></h3>
          <% if (p.excerpt) { %><p><%= p.excerpt %></p><% } %>
          <span class="more">Leer más →</span>
        </div>
      </a>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div><span class="kicker">La plantilla</span><h2>Jugadores</h2></div>
      <a class="btn ghost sm" href="/jugadores">Ver todos</a>
    </div>
    <% if (!players.length) { %>
      <div class="empty-state">Aún no hay jugadores cargados.</div>
    <% } else { %>
    <div class="grid players">
      <% players.forEach(function(pl){ %>
        <%- include('partials/player-card', { pl: pl }) %>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
