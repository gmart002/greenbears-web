# Copia a .env y completa (NO subir .env a git).
# Clave del panel de administración (/admin). Usa una larga.
ADMIN_PASSWORD=cambia-esta-clave-larga
# Alternativa más segura (hash bcrypt). Si la defines, ignora ADMIN_PASSWORD:
# ADMIN_PASSWORD_HASH=$2a$10$....
# Secreto para firmar la cookie de sesión (cadena aleatoria larga).
SESSION_SECRET=pon-aqui-una-cadena-aleatoria-muy-larga
# URL de la pizarra que se embebe en /pizarra
PIZARRA_URL=https://pizarra.grapmining.com
